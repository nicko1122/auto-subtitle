# ==============================================================================
# AutoSubtitle AI Studio - 雲端 LLM API 校對設定檔模板 (.env.example)
# ==============================================================================
# 說明：
#   1. 請複製此檔案為 .env，並在下方填入您想使用的 API Key（只需填寫其中一種即可）。
#   2. 儲存 .env 後無需重啟伺服器，下次執行「AI 產生字幕」或「校對字幕」即自動生效！
# ==============================================================================

# 供應商選擇：auto (自動偵測已填寫的 Key) | gemini | openai | anthropic
LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# 【方案 A】Google Gemini API (推薦：速度快、免費額度高、繁中歌詞校對極準)
# 取得方式：https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 【方案 B】OpenAI 或 OpenAI 相容 API (支援 OpenAI / OpenRouter / DeepSeek / Groq)
# 若使用 OpenRouter 可填：OPENAI_BASE_URL=https://openrouter.ai/api/v1
# 若使用 DeepSeek 可填：  OPENAI_BASE_URL=https://api.deepseek.com/v1
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 【方案 C】Anthropic Claude API
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
