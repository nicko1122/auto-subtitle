{
  "version": "1.0.0",
  "source_file": "/mnt/d/projects/auto-subtitle/inputclip/audio.wav",
  "duration": 182.56,
  "language": "zh",
  "segments": [
    {
      "id": 1,
      "start": 11.2,
      "end": 13.84,
      "text": "牆上的時鐘，滴答滴答。",
      "words": []
    },
    {
      "id": 2,
      "start": 13.84,
      "end": 16.22,
      "text": "你和我卡在沙發兩端晃啊晃。",
      "words": []
    },
    {
      "id": 3,
      "start": 16.6,
      "end": 19.46,
      "text": "像隔著太平洋，想不想啊。",
      "words": []
    },
    {
      "id": 4,
      "start": 19.46,
      "end": 21.74,
      "text": "我想戳破這死寂的感覺。",
      "words": []
    },
    {
      "id": 5,
      "start": 22.4,
      "end": 25.5,
      "text": "你的腦袋裝什麼，我沒搞懂。",
      "words": []
    },
    {
      "id": 6,
      "start": 25.5,
      "end": 28.3,
      "text": "我的世界在下雪，愛也結冰。",
      "words": []
    },
    {
      "id": 7,
      "start": 28.3,
      "end": 30.7,
      "text": "同一個戰場上，兩個人交火。",
      "words": []
    },
    {
      "id": 8,
      "start": 30.7,
      "end": 33.74,
      "text": "沒交集，不理解，被命運推到邊緣。",
      "words": []
    },
    {
      "id": 9,
      "start": 34.3,
      "end": 36.74,
      "text": "大樓傾，退路斷，命懸一線！",
      "words": []
    },
    {
      "id": 10,
      "start": 36.74,
      "end": 39.62,
      "text": "那一秒對上眼，心照不宣。",
      "words": []
    },
    {
      "id": 11,
      "start": 39.62,
      "end": 42.32,
      "text": "本能在深處合作無間——",
      "words": []
    },
    {
      "id": 12,
      "start": 42.32,
      "end": 45.06,
      "text": "這是你我之間唯一默契...對或不對？",
      "words": []
    },
    {
      "id": 13,
      "start": 45.8,
      "end": 48.46,
      "text": "沒有感覺，管他現在到底是誰。",
      "words": []
    },
    {
      "id": 14,
      "start": 48.46,
      "end": 62.58,
      "text": "這溫度冷得，連冰雪都像眼淚。",
      "words": []
    },
    {
      "id": 15,
      "start": 62.58,
      "end": 65.44,
      "text": "真的好冷，靈魂快要被凍結。",
      "words": []
    },
    {
      "id": 16,
      "start": 65.44,
      "end": 67.84,
      "text": "當世界只剩下一片漆黑。",
      "words": []
    },
    {
      "id": 17,
      "start": 67.84,
      "end": 70.64,
      "text": "寂寞在漫延，心裡在破碎。",
      "words": []
    },
    {
      "id": 18,
      "start": 70.64,
      "end": 73.54,
      "text": "我搖搖頭，說這感情別再追。",
      "words": []
    },
    {
      "id": 19,
      "start": 73.54,
      "end": 76.26,
      "text": "身子在抖，眼神放空。",
      "words": []
    },
    {
      "id": 20,
      "start": 76.26,
      "end": 79.48,
      "text": "腳步沉重，我們穿過水泥叢林發著瘋。",
      "words": []
    },
    {
      "id": 21,
      "start": 79.48,
      "end": 81.22,
      "text": "你扯衣角，我迎著風。",
      "words": []
    },
    {
      "id": 22,
      "start": 81.22,
      "end": 84.46,
      "text": "城市病了，喘口氣都像服刑。",
      "words": []
    },
    {
      "id": 23,
      "start": 84.46,
      "end": 87.22,
      "text": "但你看前面，那個路口。",
      "words": []
    },
    {
      "id": 24,
      "start": 87.22,
      "end": 90.26,
      "text": "轉過街角，路燈還亮著。",
      "words": []
    },
    {
      "id": 25,
      "start": 90.26,
      "end": 94.28,
      "text": "去偷一秒，微弱的溫熱。",
      "words": []
    },
    {
      "id": 26,
      "start": 94.98,
      "end": 100.26,
      "text": "搓熱手指，證明我們還活著。",
      "words": []
    },
    {
      "id": 27,
      "start": 102.14,
      "end": 104.94,
      "text": "沒有感覺，管他現在到底是誰。",
      "words": []
    },
    {
      "id": 28,
      "start": 104.94,
      "end": 107.7,
      "text": "這溫度冷得，連冰雪都像眼淚。",
      "words": []
    },
    {
      "id": 29,
      "start": 107.7,
      "end": 110.62,
      "text": "真的好冷，靈魂快要被凍結。",
      "words": []
    },
    {
      "id": 30,
      "start": 110.62,
      "end": 112.92,
      "text": "當世界只剩下一片漆黑。",
      "words": []
    },
    {
      "id": 31,
      "start": 113.6,
      "end": 116.26,
      "text": "沒有感覺，管他現在到底是誰。",
      "words": []
    },
    {
      "id": 32,
      "start": 116.26,
      "end": 119.04,
      "text": "這溫度冷得，連冰雪都像眼淚。",
      "words": []
    },
    {
      "id": 33,
      "start": 119.04,
      "end": 122.14,
      "text": "真的好冷，我們在風雪裡退讓。",
      "words": []
    },
    {
      "id": 34,
      "start": 122.14,
      "end": 124.82,
      "text": "只能咬著牙，繼續抵抗這絕望。",
      "words": []
    },
    {
      "id": 35,
      "start": 124.82,
      "end": 127.58,
      "text": "空殼軀殼，沒人敢示弱。",
      "words": []
    },
    {
      "id": 36,
      "start": 127.58,
      "end": 130.42,
      "text": "巷弄回響，散了又墜落。",
      "words": []
    },
    {
      "id": 37,
      "start": 130.42,
      "end": 133.06,
      "text": "面具下沉默，誰都不敢說。",
      "words": []
    },
    {
      "id": 38,
      "start": 133.06,
      "end": 135.82,
      "text": "躲到哪裡去，都冷得犯錯。",
      "words": []
    },
    {
      "id": 39,
      "start": 135.82,
      "end": 138.86,
      "text": "沒有感覺，管他現在到底是誰。",
      "words": []
    },
    {
      "id": 40,
      "start": 138.86,
      "end": 141.52,
      "text": "這溫度冷得，連冰雪都像眼淚。",
      "words": []
    },
